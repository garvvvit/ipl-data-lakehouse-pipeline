# ===================================================
# IPL Data Lakehouse Pipeline Environment Variables
# ===================================================

# Airflow Core Configuration
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_EMAIL=admin@example.com

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=garvit-ipl-data-lake
AWS_IAM_INSTANCE_PROFILE_ARN=arn:aws:iam::925729918104:instance-profile/databricks-s3-access-role

# Databricks Configuration
DATABRICKS_HOST=https://your-databricks-instance.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_databricks_personal_access_token

# Monitoring & Slack Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL
